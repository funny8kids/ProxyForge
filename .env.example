# ProxyForge 本地开发环境变量
#
# 复制为 .env 后按需修改。全部有默认值，不配置也能 `npm run dev`。
# 生产部署的环境变量清单见 docs/operations/01-deployment-observability.md。

# ── HTTP ───────────────────────────────────────────────────────────
PORT=8081
HOST=127.0.0.1

# ── 数据库 ─────────────────────────────────────────────────────────
# PGlite 数据目录（PostgreSQL 16 编译到 WASM，进程内运行）。
# 设为 memory:// 则使用内存库，进程退出即丢失 —— 仅用于测试。
DATABASE_URL=.data/pg

# ── Worker ─────────────────────────────────────────────────────────
# embedded（默认）：worker 循环挂在 API 进程内。
#   PGlite 是单写者，同一 data 目录不能被两个进程打开，
#   否则直接崩在 initdb。本地开发必须用这个值。
# process：worker 独立进程，恢复 ADR-0002 的数据面分离形态。
#   接真实 PostgreSQL 16 后改用它。
PF_WORKER_MODE=embedded

OUTBOX_INTERVAL_MS=500
SCHEDULER_INTERVAL_MS=15000

# ── 安全 ───────────────────────────────────────────────────────────
# 信封加密主密钥。**生产必须由 KMS / 环境注入，不得使用默认值。**
PF_MASTER_KEY=dev-only-master-key-do-not-use-in-prod

# 允许 AI 供应商访问内网地址（本地 Ollama 场景）。默认关闭，
# 开启等于放开 SSRF 防护的一条口子，仅 ADMIN 可操作。
PF_ALLOW_PRIVATE_AI=false

# ── AI ─────────────────────────────────────────────────────────────
# DeepSeek 密钥。启动时由 db/bootstrap-ai.ts 读入并做信封加密后落库，
# 之后库里只存密文，接口只返回脱敏值。留空则跳过注入。
# 轮换密钥只需改这里再重启，不需要 db:reset。
PF_DEEPSEEK_API_KEY=

# 探针模式：live 真实探测 / fixture 合成结果
#
# 分级探测调度（verification/schedule.ts）会周期性把到期端点排成探测任务。
# 种子端点用的是 RFC 5737 文档保留段，不可路由：live 模式下每个节点都要
# 等满 4 秒超时再判死，几分钟内整库会变成 UNAVAILABLE、池子清空。
# 所以**种子环境必须用 fixture**（界面顶部会显示「示例数据」徽章）。
# 接入真实来源之后改成 live。
PF_PROBE_MODE=fixture

# 探测并发与每轮批次。两个数是一组：
#   批次 / 并发 × 4 秒超时 必须小于 15 秒的调度周期（SCHEDULER_INTERVAL_MS），
#   否则批次永远跑不完，会被"已有任务在跑"的守卫跳过，加预算反而不涨吞吐。
# 免费代理的探测以"等超时"为主，所以这两个数直接决定筛出可用节点的速度。
PF_PROBE_CONCURRENCY=48
PF_PROBE_BATCH=120

# ── 日志 ───────────────────────────────────────────────────────────
LOG_LEVEL=info
