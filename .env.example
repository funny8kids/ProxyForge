# ProxyForge 本地开发环境变量
#
# 复制为 .env 后按需修改。全部有默认值，不配置也能 `npm run dev`。
# 生产部署的环境变量清单见 docs/operations/01-deployment-observability.md。

# ── HTTP ───────────────────────────────────────────────────────────
PORT=8081
HOST=127.0.0.1

# ── 数据库 ─────────────────────────────────────────────────────────
# PGlite 数据目录（PostgreSQL 16 编译到 WASM，进程内运行）。
# 设为 memory:// 则使用内存库，进程退出即丢失 —— 仅用于测试。
DATABASE_URL=.data/pg

# ── Worker ─────────────────────────────────────────────────────────
# embedded（默认）：worker 循环挂在 API 进程内。
#   PGlite 是单写者，同一 data 目录不能被两个进程打开，
#   否则直接崩在 initdb。本地开发必须用这个值。
# process：worker 独立进程，恢复 ADR-0002 的数据面分离形态。
#   接真实 PostgreSQL 16 后改用它。
PF_WORKER_MODE=embedded

OUTBOX_INTERVAL_MS=500
SCHEDULER_INTERVAL_MS=15000

# ── 安全 ───────────────────────────────────────────────────────────
# 信封加密主密钥。**生产必须由 KMS / 环境注入，不得使用默认值。**
PF_MASTER_KEY=dev-only-master-key-do-not-use-in-prod

# 允许 AI 供应商访问内网地址（本地 Ollama 场景）。默认关闭，
# 开启等于放开 SSRF 防护的一条口子，仅 ADMIN 可操作。
PF_ALLOW_PRIVATE_AI=false

# ── 日志 ───────────────────────────────────────────────────────────
LOG_LEVEL=info
