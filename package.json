{
  "name": "proxyforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ProxyForge — Network Resource Control Plane",
  "engines": {
    "node": ">=22.6"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:migrate": "npm run -w @proxyforge/api db:migrate",
    "db:seed": "npm run -w @proxyforge/api db:seed",
    "db:reset": "npm run -w @proxyforge/api db:reset",
    "dev:api": "npm run -w @proxyforge/api dev",
    "dev:worker": "npm run -w @proxyforge/api dev:worker",
    "dev:web": "npm run -w @proxyforge/web dev",
    "dev": "node scripts/dev.mjs",
    "build": "npm run -w @proxyforge/contracts build && npm run -w @proxyforge/api build && npm run -w @proxyforge/web build",
    "typecheck": "npm run -w @proxyforge/contracts build && npm run -w @proxyforge/api typecheck && npm run -w @proxyforge/web typecheck",
    "verify": "node scripts/verify.mjs",
    "test:engine": "node node_modules/tsx/dist/cli.mjs scripts/gateway-engine.test.mts",
    "test:render": "node node_modules/tsx/dist/cli.mjs scripts/subscription-render.test.mts",
    "db:check": "npm run -w @proxyforge/api db:check",
    "db:query": "node node_modules/tsx/dist/cli.mjs scripts/db-query.mts",
    "diag:freshness": "node node_modules/tsx/dist/cli.mjs scripts/diag-freshness.mts",
    "diag:funnel": "node node_modules/tsx/dist/cli.mjs scripts/diag-funnel.mts",
    "diag:yield": "node node_modules/tsx/dist/cli.mjs scripts/diag-yield.mts",
    "bench:probe": "node node_modules/tsx/dist/cli.mjs scripts/bench-probe.mts",
    "test:events": "node node_modules/tsx/dist/cli.mjs scripts/events-pipeline.test.mts",
    "test:quality": "node node_modules/tsx/dist/cli.mjs scripts/source-quality.test.mts",
    "test:schedule": "node node_modules/tsx/dist/cli.mjs scripts/probe-schedule.test.mts",
    "test:verify": "node node_modules/tsx/dist/cli.mjs scripts/verification-job.test.mts",
    "check:subscription": "node scripts/check-subscription.mjs",
    "test:promote": "node node_modules/tsx/dist/cli.mjs scripts/promote-order.test.mts",
    "diag:cadence": "node node_modules/tsx/dist/cli.mjs scripts/diag-sync-cadence.mts",
    "diag:demoted": "node node_modules/tsx/dist/cli.mjs scripts/diag-demoted.mts",
    "diag:tunnel": "node node_modules/tsx/dist/cli.mjs scripts/diag-tunnel.mts"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  }
}
